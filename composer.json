{
    "name": "php-io-extensions/metal",
    "type": "php-ext",
    "description": "Metal bound 1:1 into PHP (Zephir extension, macOS only)",
    "license": "MIT",
    "version": "0.8.0",
    "authors": [
        {
            "name": "Project Saturn Studios, LLC",
            "email": "info@projectsaturnstudios.com"
        }
    ],
    "require": {
        "php": ">=8.4"
    },
    "php-ext": {
        "extension-name": "metal",
        "priority": 30,
        "build-path": "ext",
        "support-zts": true,
        "support-nts": true,
        "os-families": ["darwin"],
        "configure-options": [
            {
                "name": "enable-metal",
                "description": "Enable the metal extension (macOS only)",
                "needs-value": false
            }
        ]
    }
}
